# --- Python ---
.venv/
__pycache__/
*.pyc
.env

# --- Runtime data (never commit generated data) ---
runtime/
# SQLite Mirror is generated runtime data; keep database, WAL/SHM, staging,
# backups and validation reports out of Git explicitly for clarity.
runtime/db/*.db
runtime/db/*.db-shm
runtime/db/*.db-wal
runtime/db/backups/
runtime/db/staging/
runtime/db/reports/
logs/
snapshots/
exports/
images/
temp/
backups/

# --- Temp / backup files ---
*.tmp
*.bak

# --- Node artifacts (reference scraper lives outside this repo) ---
node_modules/
